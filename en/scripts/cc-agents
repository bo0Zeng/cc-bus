#!/usr/bin/env bash
# cc-agents  List sessions spawned by cc-spawn (as opposed to manually started ones), flagging alive/exited.
set -uo pipefail
BUS="${CC_BUS_HOME:-$HOME/.cc-bus}"
[ -f "$BUS/spawned.tsv" ] || { echo "(no sessions spawned yet)"; exit 0; }
printf '%-18s %-6s %-40s %s\n' ID STATUS DIR TASK
while IFS=$'\t' read -r id dir ts task; do
  [ -n "${id:-}" ] || continue
  if tmux has-session -t "=$id" 2>/dev/null; then st=alive; else st=exited; fi
  printf '%-18s %-6s %-40s %s\n' "$id" "$st" "${dir:-}" "${task:-}"
done < "$BUS/spawned.tsv"
