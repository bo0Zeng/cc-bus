#!/usr/bin/env bash
# cc-recv [id]  Read new messages for this agent since last time, and advance the "read position" (the single consumption entry point)
set -euo pipefail
BUS="${CC_BUS_HOME:-$HOME/.cc-bus}"
SELFDIR=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)
if [ -n "${1:-}" ]; then id="$1"; else id=$("$SELFDIR/cc-whoami"); fi   # If no arg, auto-claim identity
case "$id" in *[!A-Za-z0-9_-]*|'') echo "cc-recv: invalid/empty id '$id'" >&2; exit 2;; esac
inbox="$BUS/inbox/$id.jsonl"
posf="$BUS/state/$id.pos"
[ -f "$inbox" ] || exit 0
(
  flock 9
  # Count lines with awk: this also counts "last line has no trailing newline", matching the line-range semantics of sed below
  total=$(awk 'END{print NR}' "$inbox")
  pos=$(cat "$posf" 2>/dev/null || echo 0)
  [[ "$pos" =~ ^[0-9]+$ ]] || pos=0          # If pos is truncated/corrupted, self-heal by resetting to 0 instead of silently failing
  [ "$pos" -le "$total" ] || pos=0           # If inbox was externally cleared/truncated while pos stayed high -> reset to 0, don't end up never receiving again
  if [ "$total" -gt "$pos" ]; then
    new=$(sed -n "$((pos+1)),\$p" "$inbox")
    # Display: fromjson? skips malformed JSON lines (avoids getting stuck on a poison line), // tolerates v1 lines missing fields by default
    printf '%s\n' "$new" \
      | jq -Rr 'fromjson? // empty | "[cc-bus from \(.from // "?") @ \(.ts // "?") (\(.id // "-"))]\n\(.text // "")\n(reply: cc-send \(.from // "?") \"…\")\n"'
    # Record lastread-<self>__<from>=id\thops\ttrace for each message (used by F03's causal chain); malformed lines/invalid from are skipped
    printf '%s\n' "$new" | while IFS= read -r line; do
      [ -n "$line" ] || continue
      obj=$(printf '%s' "$line" | jq -Rc 'fromjson? // empty')
      [ -n "$obj" ] || continue              # Skip malformed JSON lines
      f=$(printf '%s' "$obj" | jq -r '.from // "?"')
      case "$f" in *[!A-Za-z0-9_-]*|'') continue;; esac   # Don't write a path for an invalid sender
      mid=$(printf '%s' "$obj" | jq -r '.id // "-"')
      hp=$(printf '%s' "$obj" | jq -r '.hops // 0')
      tr=$(printf '%s' "$obj" | jq -r '.trace // .from // "?"')
      lrf="$BUS/state/lastread-${id}__${f}"    # Atomic write (tmp+mv), avoids cc-send's lock-free read seeing a half-written file
      printf '%s\t%s\t%s\n' "$mid" "$hp" "$tr" > "$lrf.tmp.$$" && mv "$lrf.tmp.$$" "$lrf"
    done
    echo "$total" > "$posf"
  fi
) 9>>"$inbox.lock"
